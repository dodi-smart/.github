{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dodi-smart/.github"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "customManagers": [
    {
      "description": "The hk schema hk.pkl amends, pinned in its package URL. Grouped with the hk binary in mise.toml so both move together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^hk\\.pkl$/"
      ],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#"
    }
  ],
  "packageRules": [
    {
      "description": "A bump to a lint tool in mise.toml or hk.pkl changes nothing callers run, so it must not cut a release",
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "self-test"
    },
    {
      "description": "The hk binary and the hk.pkl schema version move in one PR",
      "matchPackageNames": [
        "jdx/hk",
        "aqua:jdx/hk"
      ],
      "groupName": "hk"
    }
  ]
}
