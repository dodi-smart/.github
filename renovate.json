{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dodi-smart/.github"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "npmrc": "allow-remote=all",
  "customManagers": [
    {
      "description": "The hk schema hk.pkl amends, pinned in its package URL. Grouped with the hk binary in mise.toml so both move together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^hk\\.pkl$/"
      ],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#"
    },
    {
      "description": "squawk, pinned in the migration-lint action's install script by the marker comment above its version",
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/migration-lint/install\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+SQUAWK_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ]
    },
    {
      "description": "firebase-tools, pinned exact in android-deploy.yml behind a renovate marker. The shared preset enables no manager for _VERSION markers, so this one reads that single file",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/android-deploy\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+FIREBASE_TOOLS_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"
      ]
    },
    {
      "description": "The react-doctor version the action and its workflow default to, read from the trailing renovate marker on each default",
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/react-doctor/action\\.yml$/",
        "/^\\.github/workflows/react-doctor\\.yml$/"
      ],
      "matchStrings": [
        "default:\\s*['\"](?<currentValue>\\d+\\.\\d+\\.\\d+)['\"][^#\\n]*# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    },
    {
      "description": "The osv-scanner version actions/dependency-check installs: a renovate marker comment, then the pinned version on the next line",
      "customType": "regex",
      "managerFilePatterns": [
        "/^actions/dependency-check/install\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\nOSV_SCANNER_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\n"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "A bump to a lint tool in mise.toml or hk.pkl changes nothing callers run, so it must not cut a release",
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "self-test"
    },
    {
      "description": "The hk binary and the hk.pkl schema version move in one PR",
      "matchPackageNames": [
        "jdx/hk",
        "aqua:jdx/hk"
      ],
      "groupName": "hk"
    },
    {
      "description": "Each of these is what a shared workflow or action runs for callers (migration-lint, the deploy workflow, the react-doctor scan, dependency-check), so a bump releases like any chore(deps), unlike the other custom.regex pins",
      "matchDepNames": [
        "sbdchd/squawk",
        "firebase-tools",
        "react-doctor",
        "google/osv-scanner"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "android-deploy.yml pins this action to a commit SHA because it runs with the signing key's service-account token, so a bump is read by a person and never merged unattended",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "1password/load-secrets-action"
      ],
      "groupName": "1password",
      "automerge": false
    }
  ]
}
